rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // SINGLE SOURCE OF TRUTH: this file in the alpine-portal repo.
    // To change rules: edit this file, commit it, then in the Firebase
    // console (Firestore > Rules) select ALL, paste the WHOLE file, Publish.
    // Never append to the console editor: anything placed after the
    // closing brace of this block is silently ignored and those saves fail.
    //
    // {doc=**} also covers each document's "versions" history subcollection.
    // ─────────────────────────────────────────────────────────────────

    // ── Who's who ──
    // People and roles live in portal_users/{email}, managed on Users & Settings
    // (users.html, owners only). An email with no portal_users record falls back
    // to the built-in lists below (keep them in sync with AP_USERS in auth.js);
    // a record with active == false has no access at all.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function userPath() {
      return /databases/$(database)/documents/portal_users/$(email());
    }
    function hasRecord() {
      return exists(userPath());
    }
    // role is one of: owner, super_admin, finance, sales, support, field_ops, ops
    function hasRole(role, fallback) {
      return signedIn() && (hasRecord()
        ? (get(userPath()).data.get('active', true) != false && role in get(userPath()).data.roles)
        : email() in fallback);
    }
    function isSales() {
      return hasRole('sales', [
        'jake.gilmore@alpinehvac.ca',
        'mike.launder@alpinehvac.ca',
        'cole.hamilton@alpinehvac.ca',
        'natalie.townsend@alpinehvac.ca'
      ]);
    }
    function isAdmin() {
      return hasRole('super_admin', [
        'jake.gilmore@alpinehvac.ca',
        'mike.launder@alpinehvac.ca',
        'clarissa.launder@alpinehvac.ca',
        'cole.hamilton@alpinehvac.ca'
      ]);
    }
    function isOwner() {
      return hasRole('owner', [
        'jake.gilmore@alpinehvac.ca',
        'mike.launder@alpinehvac.ca'
      ]);
    }
    function isOps() {
      return hasRole('ops', [
        'cole.hamilton@alpinehvac.ca',
        'steven.coles@alpinehvac.ca',
        'nick.drost@alpinehvac.ca',
        'tyson.marcoux@alpinehvac.ca',
        'brandon.launder@alpinehvac.ca',
        'matt.martin@alpinehvac.ca'
      ]);
    }
    // Field Operations job pipeline (shared materials + task checklists): owners + field_ops (Cole)
    function isFieldOps() {
      return isOwner() || hasRole('field_ops', [
        'cole.hamilton@alpinehvac.ca'
      ]);
    }
    function isFinance() {
      return hasRole('finance', [
        'jake.gilmore@alpinehvac.ca',
        'mike.launder@alpinehvac.ca',
        'clarissa.launder@alpinehvac.ca'
      ]);
    }

    // Users & Settings: everyone can read their OWN record (sign-in needs it);
    // owners read and manage everyone's. Each record must keep a roles list.
    match /portal_users/{userEmail} {
      allow get: if signedIn() && email() == userEmail;
      allow read: if isOwner();
      allow create, update: if isOwner() && userEmail == userEmail.lower()
        && request.resource.data.roles is list && request.resource.data.name is string;
      allow delete: if isOwner();
    }

    // Financial Position + Job Profit: finance only
    match /cash_dashboard/{doc=**} {
      allow read, write: if isFinance();
    }
    match /cash_dashboard_history/{doc=**} {
      allow read, write: if isFinance();
    }

    // Field Operations dashboard (daily BuildOps refresh): Cole can read, only owners save the refresh
    match /ops_dashboard/{doc=**} {
      allow read: if isFieldOps();
      allow write: if isOwner();
    }
    // Field Operations job pipeline: ordered checkmarks, order notes, tasks, stage moves (one doc per job)
    match /ops_jobs/{doc=**} {
      allow read, write: if isFieldOps();
    }
    // Job pages (job.html): visits, tech summaries, hours, materials (one doc per job + _index).
    // Owners, Cole and field techs read; only owners save the daily refresh.
    match /ops_job_detail/{doc=**} {
      allow read: if isFieldOps() || isOps();
      allow write: if isOwner();
    }
    // Job costs, QuickBooks bills/invoices and Outlook emails per job: Jake, Mike and Cole read; owners save
    match /ops_job_costs/{doc=**} {
      allow read: if isFieldOps();
      allow write: if isOwner();
    }
    // ── Tech mobile (tech.html) ──
    // Visits: the office (owners + field_ops) creates and assigns them; a tech reads only visits
    // that list their email in techEmails, and may only change the visit's status fields.
    match /fs_visits/{id} {
      allow read: if isFieldOps() || (isOps() && email() in resource.data.techEmails);
      allow create, delete: if isFieldOps();
      allow update: if isFieldOps()
        || (isOps() && email() in resource.data.techEmails
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy', 'updatedAt']));
    }
    // Hours, visit summaries and photos: each record names its tech; techs read and write only their own.
    match /fs_time/{id} {
      allow read: if isFieldOps() || (isOps() && resource.data.tech == email());
      allow create: if isFieldOps() || (isOps() && request.resource.data.tech == email());
      allow update, delete: if isFieldOps() || (isOps() && resource.data.tech == email() && request.resource.data.tech == email());
    }
    // Visit summaries: a dated log, one entry per save. Everyone on the tools reads them (techs see the
    // whole visit's story, the office sees all). Techs add entries signed as themselves and can fix their
    // own until the visit is complete; the office can fix any. Entries are never deleted from the phone.
    match /fs_summaries/{id} {
      allow read: if isOps() || isFieldOps();
      allow create: if (isOps() || isFieldOps()) && request.resource.data.tech == email()
                    && request.resource.data.text is string && request.resource.data.text.size() < 20000;
      allow update: if isFieldOps()
                    || (isOps() && resource.data.tech == email()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt", "editedBy", "updatedAt"])
                        && get(/databases/$(database)/documents/fs_visits/$(resource.data.visitId)).data.status != "complete");
      allow delete: if isFieldOps();
    }
    // Equipment at each site: everyone on the tools reads it; the office adds and edits units.
    match /fs_equipment/{id} {
      allow read: if isOps() || isFieldOps();
      allow create, update, delete: if isFieldOps();
    }
    // Dated notes on a site or a unit: everyone on the tools reads and adds (signed as themselves).
    // Notes are never edited, so the date and author can be trusted. The writer or the office can delete.
    match /fs_notes/{id} {
      allow read: if isOps() || isFieldOps();
      allow create: if (isOps() || isFieldOps()) && request.resource.data.by == email()
                    && request.resource.data.text is string && request.resource.data.text.size() < 4000;
      allow update: if false;
      allow delete: if isFieldOps() || resource.data.by == email();
    }
    // Time clock: each tech has one running clock (fs_clock/{tech}); they read and write only their own.
    match /fs_clock/{id} {
      allow read: if isFieldOps() || (isOps() && (resource == null || resource.data.tech == email()));
      allow create, update: if (isOps() || isFieldOps()) && request.resource.data.tech == email();
      allow delete: if isFieldOps() || (isOps() && resource.data.tech == email());
    }
    // Company time rules (paid breaks, drive time, rounding): everyone on the tools reads, owners change.
    match /fs_settings/{id} {
      allow read: if isOps() || isFieldOps();
      allow write: if isOwner();
    }
    // Photos are stored in the document itself (compressed, under 900 KB) until Firebase Storage is switched on.
    match /fs_photos/{id} {
      allow read: if isFieldOps() || (isOps() && resource.data.tech == email());
      allow create: if (isFieldOps() || (isOps() && request.resource.data.tech == email()))
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow update: if isFieldOps() || (isOps() && resource.data.tech == email() && request.resource.data.tech == email());
      allow delete: if isFieldOps() || (isOps() && resource.data.tech == email());
    }
    // Invoicing: reviewed invoices (one doc per job) + the daily sweep (doc "sweep"): Jake, Mike and Cole
    match /invoicing_data/{doc=**} {
      allow read, write: if isFieldOps();
    }
    // Item List (items.html): equipment, labour, materials price list + category tree: Jake, Mike and Cole
    match /items_data/{doc=**} {
      allow read, write: if isFieldOps();
    }
    match /items_meta/{doc=**} {
      allow read, write: if isFieldOps();
    }
    // PO Numbers (po-numbers.html): one doc per PO + po_meta/config (counter, sections).
    // Whole team reads; only admins (Jake, Mike, Clarissa, Cole) issue, edit or archive.
    match /po_numbers/{doc=**} {
      allow read: if isAdmin() || isSales() || isOps() || isFinance();
      allow write: if isAdmin();
    }
    match /po_meta/{doc=**} {
      allow read: if isAdmin() || isSales() || isOps() || isFinance();
      allow write: if isAdmin();
    }
    // Business Context log: one source of truth read by every dashboard refresh: owners only
    match /portal_context/{doc=**} {
      allow read, write: if isOwner();
    }
    match /ops_dashboard_history/{doc=**} {
      allow read, write: if isOwner();
    }

    // Site Reports (maintenance checklists, customer summaries): sales + ops
    match /site_reports_data/{doc=**} {
      allow read, write: if isSales() || isOps();
    }

    // Site pages: BuildOps activity per address + CLEAR reports: sales + ops
    match /site_data/{doc=**} {
      allow read, write: if isSales() || isOps();
    }

    // Account Management: customer contacts, notes, report history + customization: Jake, Mike + Cole
    match /account_data/{doc=**} {
      allow read, write: if isFieldOps();
    }
    // Customer live report links (account-report.html?t=<token>): anyone holding the link can open ONE
    // snapshot (no dollar amounts); nobody can list them. Jake, Mike and Cole publish, update or turn a link off.
    match /account_share/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create, update, delete: if isFieldOps();
    }

    // Building Performance Audits (records) + audit photos (one doc per photo): sales only
    match /audit_data/{doc=**} {
      allow read, write: if isSales();
    }
    match /audit_photos/{doc=**} {
      allow read, write: if isSales();
    }

    // Outbound territory map (lead sheet copy, targets, claims, geocode cache): sales only
    match /outbound_data/{doc=**} {
      allow read, write: if isSales();
    }

    // Sales dashboard metrics (QuickBooks-derived CAC, LTV, ticket, growth): sales read, owners save
    match /sales_dashboard/{doc=**} {
      allow read: if isSales();
      allow write: if isOwner();
    }
    match /sales_dashboard_history/{doc=**} {
      allow read, write: if isOwner();
    }

    // Service Agreement Tracker: sales only
    match /service_agreements_data/{doc=**} {
      allow read, write: if isSales();
    }

    // Service Agreement Calculator: sales + super admins
    match /service_agreement_data/{doc=**} {
      allow read, write: if isSales() || isAdmin();
    }

    // Sales Strategy: sales + super admins
    match /sales_strategy_data/{doc=**} {
      allow read, write: if isSales() || isAdmin();
    }

    // Team Hub (recruiting, onboarding): super admins only
    match /team_hub_data/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Team Hub > Pre-Interview resume files (one doc per file): super admins only
    match /team_hub_resumes/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Team Hub > Team Files + Quarterly Reviews: owners (Jake, Mike) only
    match /team_files_data/{doc=**} {
      allow read, write: if isOwner();
    }

    // Everything else is denied by default.
  }
}
